#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def DistantLight "KeyLight"
    {
        float intensity = 5000
        float angle = 0.5
    }

    def Camera "PreviewCamera"
    {
        float focalLength = 18
        float2 clippingRange = (0.01, 10000)
        double3 xformOp:translate = (0, -8, 3)
        double3 xformOp:rotateXYZ = (65, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }

    def Xform "Lounge3DGUT" (
        prepend references = @../../../../../3D_files/3DGUT_USDZ/lounge_3dgut_mcmc_300k_standard.usdz@
    )
    {
        quatf xformOp:orient = (0.70710677, 0.70710677, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:orient"]
    }

    def Mesh "GroundPlane" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
    )
    {
        uniform bool doubleSided = 1
        float3[] extent = [(-12, -12, 0), (12, 12, 0)]
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-12, -12, 0), (12, -12, 0), (12, 12, 0), (-12, 12, 0)]
        color3f[] primvars:displayColor = [(0.18, 0.18, 0.18)] (
            interpolation = "constant"
        )
        token subdivisionScheme = "none"
        bool physics:collisionEnabled = 1
        uniform token physics:approximation = "none"
    }
}
